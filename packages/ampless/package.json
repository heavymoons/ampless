{
  "name": "ampless",
  "version": "0.0.1",
  "description": "Serverless CMS for AWS Amplify",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./media": {
      "import": "./dist/media/index.js",
      "types": "./dist/media/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jsquash/webp": "^1.4.0"
  },
  "keywords": ["cms", "aws", "amplify", "serverless", "blog"]
}
