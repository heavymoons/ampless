{
  "name": "ampless",
  "version": "1.0.0-alpha.30",
  "description": "Serverless CMS for AWS Amplify",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./media": {
      "import": "./dist/media/index.js",
      "types": "./dist/media/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/ampless"
  },
  "homepage": "https://github.com/heavymoons/ampless#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0"
  },
  "keywords": [
    "cms",
    "aws",
    "amplify",
    "serverless",
    "blog"
  ]
}
