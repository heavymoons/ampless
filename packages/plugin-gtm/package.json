{
  "name": "@ampless/plugin-gtm",
  "version": "0.2.0-alpha.28",
  "description": "Google Tag Manager plugin for ampless",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/plugin-gtm"
  },
  "homepage": "https://github.com/heavymoons/ampless/tree/main/packages/plugin-gtm#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "ampless": "workspace:*"
  },
  "keywords": [
    "ampless",
    "plugin",
    "ampless-plugin",
    "gtm",
    "google-tag-manager",
    "analytics"
  ],
  "amplessPlugin": {
    "apiVersion": 1,
    "name": "gtm",
    "trustLevel": "untrusted",
    "capabilities": [
      "publicHead",
      "publicBody",
      "adminSettings"
    ],
    "displayName": {
      "en": "Google Tag Manager",
      "ja": "Google Tag Manager"
    }
  }
}
