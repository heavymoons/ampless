    "react-image-crop": "^11.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "aws-amplify": "^6",
    "@aws-amplify/adapter-nextjs": "^1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "aws-amplify": "^6.10.0",
    "@aws-amplify/adapter-nextjs": "^1.6.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
