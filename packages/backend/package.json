  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/heavymoons/ampless/tree/main/packages/backend#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "dependencies": {
    "@ampless/mcp-server": "workspace:*",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-appsync": "^3.1053.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1053.0",
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sqs": "^3.1053.0",
    "@aws-sdk/credential-provider-node": "^3.972.44",
    "@aws-sdk/lib-dynamodb": "^3.1053.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "@smithy/protocol-http": "^5.4.4",
    "@smithy/signature-v4": "^5.4.4",
    "ampless": "workspace:*",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@aws-amplify/backend": "^1.19.0",
    "aws-cdk-lib": "^2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.22.0",
    "@types/aws-lambda": "^8.10.161",
    "aws-cdk-lib": "^2.257.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
