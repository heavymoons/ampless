{
  "name": "@ampless/plugin-rss",
  "version": "0.0.1",
  "description": "RSS / Atom feed plugin for ampless",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "ampless": "workspace:*"
  },
  "keywords": ["ampless", "plugin", "rss", "atom", "feed"]
}
