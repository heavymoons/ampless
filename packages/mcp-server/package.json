{
  "name": "@ampless/mcp-server",
  "version": "1.0.0-beta.67",
  "description": "MCP tool registry shared by @ampless/backend mcp-handler Lambda. Installed transitively via @ampless/admin / @ampless/backend; no direct install needed.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./jsonrpc": {
      "import": "./dist/jsonrpc/index.js",
      "types": "./dist/jsonrpc/index.d.ts"
    },
    "./public": {
      "import": "./dist/public/index.js",
      "types": "./dist/public/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/heavymoons/ampless/tree/main/packages/mcp-server#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:dist": "node scripts/tool-user-error-dist-smoke.mjs"
  },
  "dependencies": {
    "ampless": "workspace:*",
    "fflate": "^0.8.3"
  },
  "keywords": [
    "ampless",
    "mcp",
    "tools"
  ]
}
