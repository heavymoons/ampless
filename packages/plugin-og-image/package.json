{
  "name": "@ampless/plugin-og-image",
  "version": "0.2.0-alpha.27",
  "description": "Dynamic Open Graph image generation plugin for ampless",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./load-image": {
      "import": "./dist/load-image.js",
      "types": "./dist/load-image.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/plugin-og-image"
  },
  "homepage": "https://github.com/heavymoons/ampless/tree/main/packages/plugin-og-image#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "ampless": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.2.15"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "ampless",
    "plugin",
    "ampless-plugin",
    "og-image",
    "opengraph"
  ],
  "amplessPlugin": {
    "apiVersion": 1,
    "name": "og-image",
    "trustLevel": "untrusted",
    "capabilities": [
      "metadata"
    ],
    "displayName": {
      "en": "OG Image",
      "ja": "OG 画像"
    }
  }
}
