{
  "name": "@ampless/plugin-schema-jsonld",
  "version": "0.1.1-alpha.10",
  "description": "JSON-LD structured data (Article schema) for ampless posts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heavymoons/ampless.git",
    "directory": "packages/plugin-schema-jsonld"
  },
  "homepage": "https://github.com/heavymoons/ampless/tree/main/packages/plugin-schema-jsonld#readme",
  "bugs": "https://github.com/heavymoons/ampless/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "ampless": "workspace:*"
  },
  "keywords": [
    "ampless",
    "plugin",
    "ampless-plugin",
    "schema",
    "json-ld",
    "structured-data",
    "seo",
    "article"
  ],
  "amplessPlugin": {
    "apiVersion": 1,
    "name": "schema-jsonld",
    "trustLevel": "untrusted",
    "capabilities": [
      "schema",
      "adminSettings"
    ],
    "displayName": {
      "en": "JSON-LD Schema",
      "ja": "JSON-LD スキーマ"
    }
  }
}
